{
  "name": "fictional-world-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "studio": "vite --open '?studio=1'",
    "build": "tsc -b && vite build",
    "deploy": "pnpm build && gh-pages -d dist",
    "preview": "vite preview",
    "extract:land": "python tools/extraction/extract_land.py",
    "fill:countries": "python tools/extraction/fill_countries_mask.py --mode safe",
    "extract:vectors": "python tools/extraction/rebuild_political_map.py",
    "generate:country-debug-labels": "python tools/extraction/generate_country_debug_labels.py",
    "generate:country-labels": "python tools/extraction/generate_country_labels.py",
    "apply:country-006-izmatia-transfer": "python tools/extraction/apply_country006_izmatia_transfer.py",
    "prepare:regions:country-006-mainland": "python tools/extraction/prepare_country006_regions.py public/data/regions/country-006/mainland/regions-config.json",
    "extract:regions:country-006-mainland": "python tools/extraction/extract_linework_regions.py public/data/regions/country-006/mainland/regions-config.json",
    "prepare:regions": "python tools/extraction/prepare_regions_mask.py public/data/regions/country-019/regions-config.json",
    "extract:regions": "python tools/extraction/extract_regions.py public/data/regions/country-019/regions-config.json",
    "extract:regions:country-008-mainland-southwest": "python tools/extraction/place_existing_regions.py public/data/regions/country-008/mainland-southwest/regions-config.json",
    "place:regions:country-008-mainland-southwest": "python tools/extraction/place_existing_regions.py public/data/regions/country-008/mainland-southwest/regions-config.json"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "maplibre-gl": "^6.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "packageManager": "pnpm@11.16.0"
}
